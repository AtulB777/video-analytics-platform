# --- Database (docker-compose overrides this to point at the postgres service)
DATABASE_URL=sqlite:///./vap.db
# DATABASE_URL=postgresql+psycopg2://vap:vap@localhost:5432/vap

# --- Detection
DETECTOR=mock                 # mock | yolo
DETECTOR_FALLBACK_TO_MOCK=false
YOLO_MODEL=yolov8n.pt         # local path (e.g. models/yolov8n.pt) or Ultralytics model name
YOLO_DEVICE=                  # '' = auto, 'cpu', '0' (first GPU)
DETECT_CLASSES=person,car,truck,bus,bicycle,motorcycle
CONFIDENCE_THRESHOLD=0.4

# --- Pipeline
PROCESSING_FPS=10
TRACKER=iou                   # iou | bytetrack (needs supervision)
QUEUE_SIZE=8
PERSIST_DETECTIONS=true
PERSIST_EVERY_N=1
METRICS_PERSIST_INTERVAL_S=5

# --- Sources
VIDEO_DIR=sample_videos
FILE_PLAYBACK_SPEED=1.0       # 1 = real time, 0 = as fast as possible
LOOP_VIDEO=true
RTSP_RECONNECT_MAX_S=30

# --- Analytics (lines/zones)
ZONES_CONFIG=configs/zones.json
# ZONES_JSON={"default": {...}}   # inline override of the file
# CROWD_THRESHOLD=5                # overrides crowd_threshold from the profile

# --- App
AUTOSTART_SAMPLE=true         # generate + start the demo stream on boot
SAMPLE_VIDEO=sample_videos/lobby_demo.mp4
LOG_LEVEL=INFO
API_URL=http://localhost:8000 # used by the Streamlit dashboard
